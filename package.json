{
	"name": "@mobilerun/n8n-nodes-mobilerun",
	"version": "1.2.1",
	"description": "n8n community node for integrating MobileRun with workflows.",
	"keywords": [
		"n8n-community-node-package",
		"n8n-community",
		"n8n-node",
		"n8n-integration",
		"workflow-automation",
		"automation",
		"ai",
		"droidrun",
		"droidrun-ai",
		"mobilerun-ai",
		"mobilerun",
		"api-integration",
		"http-api",
		"low-code",
		"no-code"
	],
	"license": "MIT",
	"homepage": "https://mobilerun.ai/",
	"repository": {
		"type": "git",
		"url": "https://github.com/droidrun/n8n-nodes-droidrun"
	},
	"engines": {
		"node": ">=20.15"
	},
	"author": {
		"name": "Lukas Ließmann",
		"email": "lukas@droidrun.ai",
		"url": "https://droidrun.ai/"
	},
	"main": "index.js",
	"scripts": {
		"build": "npx rimraf dist && tsc && gulp build:icons",
		"dev": "n8n-node dev",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/MobilerunApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Mobilerun/Mobilerun.node.js",
			"dist/nodes/Mobilerun/MobilerunTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "~0.17.0",
		"@typescript-eslint/parser": "~8.32.0",
		"eslint": "^9.39.2",
		"eslint-plugin-n8n-nodes-base": "~1.16.3",
		"globals": "^16.5.0",
		"gulp": "^5.0.0",
		"jsonc-eslint-parser": "^2.4.2",
		"prettier": "^3.5.3",
		"rimraf": "^6.1.3",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.50.1",
		"@n8n/eslint-plugin-community-nodes": "^0.7.0",
		"n8n-workflow": "1.111.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"overrides": {
		"lodash": "^4.18.0",
		"form-data": "^4.0.6",
		"flatted": "^3.4.2",
		"js-yaml": "^4.3.2",
		"handlebars": "^4.7.9",
		"picomatch@^2": "^2.3.2",
		"minimatch@^3": "^3.1.4",
		"minimatch@^5": "^5.1.8",
		"minimatch@^9": "^9.0.7",
		"minimatch@^10": "^10.2.5",
		"brace-expansion@^1": "^1.1.18",
		"brace-expansion@^2": "^2.1.4",
		"brace-expansion@^5": "^5.0.9",
		"@isaacs/brace-expansion": "^5.0.1",
		"ajv@^6": "^6.14.0",
		"picomatch@^4": "^4.0.4",
		"@humanfs/node": "^0.16.8"
	}
}
